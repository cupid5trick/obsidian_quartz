# Build-time shared password for private notes (quartz/plugins/transformers/aclProtect.ts).
# Notes tagged "@acl/private" (or access: private) are encrypted + unlisted at build
# time using this single shared password; visitors unlock the page with it.
#
# NEVER commit the real value:
#   - local dev: put the real value in a gitignored ./acl.env (sourced by dev_setup.sh)
#                or export it in your shell
#   - Netlify:   Site settings > Environment variables (build-time secret)
#
# The build FAILS (rather than publishing plaintext) whenever a private note exists
# and this variable is unset or empty.
QUARTZ_ACL_PASSWORD=
